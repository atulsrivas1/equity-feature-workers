          "additionalProperties": {}
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "initialized": {
      "type": "object",
      "properties": {
        "_meta": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {}
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cancelled": {
      "type": "object",
      "properties": {
        "requestId": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\x20-\\x7e]{1,64}(?![\\s\\S])"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        },
        "_meta": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "requestId"
      ],
      "additionalProperties": false
    },
    "tools_list": {
      "type": "object",
      "properties": {
        "cursor": {
          "const": null
