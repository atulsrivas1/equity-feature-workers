        "_meta": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "semantic_limits": {
    "meta_canonical_bytes": 2048,
    "experimental_canonical_bytes": 4096,
    "frame_including_lf": 16384,
    "depth": 32,
    "nodes": 10000
  },
  "scope": "Pre-code closed parameter freeze,14 offline denials; no product parser/protocol/runtime qualification",
  "official_sources": [
    "https://modelcontextprotocol.io/specification/2025-11-25/basic/lifecycle",
    "https://modelcontextprotocol.io/specification/2025-11-25/server/tools"
  ]
}
